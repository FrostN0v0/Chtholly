[Unit]
Description=Apply saved Chtholly configuration with verified process restart
After=network.target systemd-tmpfiles-setup.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/chtholly
EnvironmentFile=/etc/chtholly/chtholly.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/chtholly
ExecStart=/usr/local/sbin/chtholly-config-apply
TimeoutStartSec=420
UMask=0077
StateDirectory=chtholly-config-apply
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/chtholly/entari.yml /var/lib/chtholly-config-apply /run/chtholly-config-apply
