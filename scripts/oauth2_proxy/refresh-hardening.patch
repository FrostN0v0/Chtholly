+func TestChthollyRefreshFailuresRetainOnlyValidTickets(t *testing.T) {
+	for _, tc := range []struct {
+		name, body   string
+		status, want int
+		retained     bool
+	}{
+		{"outage", `{"error":"temporarily_unavailable"}`, 503, 503, true},
+		{"revocation", `{"error":"invalid_grant"}`, 400, 401, false},
+		{"invalid-client", `{"error":"invalid_client"}`, 401, 401, false},
+		{"misleading-description", `{"error":"server_error","error_description":"invalid_grant diagnostic"}`, 503, 503, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, store, req := chthollyStoredTicket(t)
+			idp := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				w.WriteHeader(tc.status)
+				_, _ = w.Write([]byte(tc.body))
+			}))
+			defer idp.Close()
+			rw := chthollyServe(chthollyRefreshHandler(store, idp.URL), req)
+			if rw.Code != tc.want {
+				t.Fatalf("got %d, want %d", rw.Code, tc.want)
+			}
+			saved, err := store.Load(req)
+			if tc.retained {
+				if err != nil || saved == nil || saved.RefreshToken != "rotating-original" {
+					t.Fatalf("transient failure destroyed record: %v", err)
+				}
+				if len(rw.Result().Cookies()) != 0 || rw.Header().Get("Location") != "" {
+					t.Fatal("outage mutated browser ticket or redirected to login")
+				}
+			} else if err == nil || saved != nil {
+				t.Fatal("revoked record survived")
+			}
+		})
+	}
+}
+
+func TestChthollyCancelledRefreshStopsWithoutDeletingTicket(t *testing.T) {
+	_, store, req := chthollyStoredTicket(t)
+	started, stopped := make(chan struct{}), make(chan struct{})
+	idp := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(started)
+		_ = r.ParseForm()
+		<-r.Context().Done()
+		close(stopped)
+	}))
+	defer idp.Close()
+	ctx, cancel := context.WithCancel(req.Context())
+	defer cancel()
+	result := make(chan *httptest.ResponseRecorder, 1)
+	h := chthollyRefreshHandler(store, idp.URL)
+	go func() { result <- chthollyServe(h, req.WithContext(ctx)) }()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("refresh did not start")
+	}
+	cancel()
+	select {
+	case rw := <-result:
+		if rw.Code != 503 || len(rw.Result().Cookies()) != 0 {
+			t.Fatal("cancellation became login")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("cancelled authentication still running")
+	}
+	select {
+	case <-stopped:
+	case <-time.After(2 * time.Second):
+		t.Fatal("provider HTTP ignored cancellation")
+	}
+	saved, err := store.Load(req)
+	if err != nil || saved == nil || saved.RefreshToken != "rotating-original" {
+		t.Fatal("cancel destroyed record")
+	}
+}
+
+func TestChthollyRedisOutageAndMalformedTickets(t *testing.T) {
+	mr, store, req := chthollyStoredTicket(t)
+	h := chthollyRefreshHandler(store, "http://127.0.0.1:1")
+	mr.SetError("LOADING temporarily unavailable")
+	rw := chthollyServe(h, req)
+	mr.SetError("")
+	if rw.Code != 503 || len(rw.Result().Cookies()) != 0 {
+		t.Fatal("Redis outage became login")
+	}
+	if saved, err := store.Load(req); err != nil || saved == nil {
+		t.Fatal("Redis outage erased record")
+	}
+	bad := httptest.NewRequest(http.MethodGet, "/oauth2/auth", nil)
+	bad.AddCookie(&http.Cookie{Name: "_oauth2_proxy", Value: "malformed"})
+	if rw := chthollyServe(h, bad); rw.Code != 401 {
+		t.Fatalf("malformed ticket returned %d", rw.Code)
+	}
+	mr.FastForward(13 * time.Hour)
+	if rw := chthollyServe(h, req); rw.Code != 401 {
+		t.Fatalf("expired record returned %d", rw.Code)
+	}
+}
