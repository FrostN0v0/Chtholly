+func chthollyStoredTicket(t *testing.T) (*miniredis.Miniredis, sessionsapi.SessionStore, *http.Request) {
+	t.Helper()
+	mr := miniredis.RunT(t)
+	store, err := redissessions.NewRedisSessionStore(&options.SessionOptions{
+		Redis: options.RedisStoreOptions{ConnectionURL: "redis://" + mr.Addr()},
+	}, &options.Cookie{Name: "_oauth2_proxy", Path: "/", Expire: 12 * time.Hour,
+		Secret: "0123456789abcdef0123456789abcdef"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = store.(*persistence.Manager).Store.(*redissessions.SessionStore).Client.(interface{ Close() error }).Close()
+	})
+	created := time.Now().Add(-10 * time.Minute)
+	expires := time.Now().Add(time.Hour)
+	session := &sessionsapi.SessionState{CreatedAt: &created, ExpiresOn: &expires,
+		User: "alice", RefreshToken: "rotating-original", AccessToken: "old-access"}
+	rw := httptest.NewRecorder()
+	req := httptest.NewRequest(http.MethodGet, "/oauth2/auth", nil)
+	if err := store.Save(rw, req, session); err != nil {
+		t.Fatal(err)
+	}
+	for _, cookie := range rw.Result().Cookies() {
+		req.AddCookie(cookie)
+	}
+	return mr, store, req
+}
+
+func chthollyRefreshHandler(store sessionsapi.SessionStore, endpoint string) http.Handler {
+	u, _ := url.Parse(endpoint)
+	provider := &providers.OIDCProvider{ProviderData: &providers.ProviderData{
+		ClientID: "test-client", ClientSecret: "test-secret", RedeemURL: u,
+	}}
+	// The local rotating-token IdP intentionally omits its optional ID token.
+	// JWT/nonce verification is covered by signed-token provider regressions.
+	return NewStoredSessionLoader(&StoredSessionLoaderOptions{
+		SessionStore: store, RefreshPeriod: time.Minute, RefreshSession: provider.RefreshSession,
+		ValidateSession: func(context.Context, *sessionsapi.SessionState) bool { return true },
+	})(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if middlewareapi.GetRequestScope(r).Session == nil {
+			w.WriteHeader(401)
+			return
+		}
+		w.WriteHeader(202)
+	}))
+}
+
+func chthollyServe(h http.Handler, req *http.Request) *httptest.ResponseRecorder {
+	rw := httptest.NewRecorder()
+	req = middlewareapi.AddRequestScope(req.Clone(req.Context()), &middlewareapi.RequestScope{})
+	h.ServeHTTP(rw, req)
+	return rw
+}
+
+func TestChthollySlowRotatingRefreshIsSingleExchange(t *testing.T) {
+	mr, store, req := chthollyStoredTicket(t)
+	var exchanges atomic.Int32
+	started := make(chan struct{})
+	idp := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if exchanges.Add(1) != 1 {
+			w.WriteHeader(400)
+			_, _ = w.Write([]byte(`{"error":"invalid_grant"}`))
+			return
+		}
+		close(started)
+		// miniredis does not advance TTLs with wall time: advance it explicitly
+		// while the real HTTP exchange is still pending beyond the old 2s lease.
+		time.Sleep(2300 * time.Millisecond)
+		mr.FastForward(2300 * time.Millisecond)
+		time.Sleep(100 * time.Millisecond)
+		_ = json.NewEncoder(w).Encode(map[string]any{"access_token": "new-access",
+			"refresh_token": "rotating-new", "expires_in": 3600, "token_type": "Bearer"})
+	}))
+	defer idp.Close()
+	h := chthollyRefreshHandler(store, idp.URL)
+	results := make(chan *httptest.ResponseRecorder, 2)
+	go func() { results <- chthollyServe(h, req) }()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("refresh did not start")
+	}
+	go func() { results <- chthollyServe(h, req) }()
+	for range 2 {
+		select {
+		case rw := <-results:
+			if rw.Code != 202 {
+				t.Fatalf("concurrent auth returned %d", rw.Code)
+			}
+		case <-time.After(25 * time.Second):
+			t.Fatal("authentication did not finish")
+		}
+	}
+	if exchanges.Load() != 1 {
+		t.Fatalf("rotating token exchanged %d times", exchanges.Load())
+	}
+	saved, err := store.Load(req)
+	if err != nil || saved == nil || saved.RefreshToken != "rotating-new" {
+		t.Fatalf("rotated session not usable: %v", err)
+	}
+}
