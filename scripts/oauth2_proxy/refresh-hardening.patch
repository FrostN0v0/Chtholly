+	"github.com/oauth2-proxy/oauth2-proxy/v7/pkg/encryption"
+	internaloidc "github.com/oauth2-proxy/oauth2-proxy/v7/pkg/providers/oidc"
+)
+
+func chthollySigningKey(t *testing.T) *rsa.PrivateKey {
+	t.Helper()
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return key
+}
+
+func chthollySignedToken(key *rsa.PrivateKey, claims idTokenClaims) (string, error) {
+	return jwt.NewWithClaims(jwt.SigningMethodRS256, claims).SignedString(key)
+}
+
+func newChthollyOIDCSetup(t *testing.T, key *rsa.PrivateKey, body []byte) (*httptest.Server, *OIDCProvider) {
+	t.Helper()
+	server, provider := newTestOIDCSetup(body)
+	provider.Verifier = internaloidc.NewVerifier(oidc.NewVerifier(oidcIssuer,
+		&oidc.StaticKeySet{PublicKeys: []crypto.PublicKey{&key.PublicKey}},
+		&oidc.Config{ClientID: oidcClientID}),
+		internaloidc.IDTokenVerificationOptions{AudienceClaims: []string{"aud"}, ClientID: oidcClientID})
+	return server, provider
+}
+
+func TestChthollyInitialNonceCannotUseRefreshExemption(t *testing.T) {
+	key := chthollySigningKey(t)
+	server, provider := newChthollyOIDCSetup(t, key, []byte(`{}`))
+	defer server.Close()
+	for _, tc := range []struct {
+		name, claimNonce, storedNonce string
+		refreshed, want               bool
+	}{
+		{"correct", defaultIDToken.Nonce, oidcNonce, false, true},
+		{"incorrect", defaultIDToken.Nonce, "wrong", false, false},
+		{"absent", "", oidcNonce, false, false},
+		{"transient-helper-is-not-proof", defaultIDToken.Nonce, "wrong", true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			claims := defaultIDToken
+			claims.Nonce = tc.claimNonce
+			raw, err := chthollySignedToken(key, claims)
+			if err != nil {
+				t.Fatal(err)
+			}
+			session := &sessions.SessionState{IDToken: raw, Nonce: []byte(tc.storedNonce), Refreshed: tc.refreshed}
+			if got := provider.ValidateSession(context.Background(), session); got != tc.want {
+				t.Fatalf("initial nonce acceptance = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestChthollyVerifiedRefreshNonceSurvivesEncryptedStore(t *testing.T) {
+	key := chthollySigningKey(t)
+	claims := defaultIDToken
+	claims.Nonce = ""
+	raw, err := chthollySignedToken(key, claims)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := json.Marshal(redeemTokenResponse{AccessToken: "new-access", RefreshToken: "new-refresh",
+		ExpiresIn: 3600, TokenType: "Bearer", IDToken: raw})
+	server, provider := newChthollyOIDCSetup(t, key, body)
+	defer server.Close()
+	provider.ValidateURL = &url.URL{}
+	initial, _ := chthollySignedToken(key, defaultIDToken)
+	session := &sessions.SessionState{IDToken: initial, Nonce: []byte(oidcNonce), RefreshToken: "old-refresh"}
+	if ok, err := provider.RefreshSession(context.Background(), session); !ok || err != nil {
+		t.Fatal(err)
+	}
+	cipher, err := encryption.NewGCMCipher([]byte("0123456789abcdef"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, err := session.EncodeSessionState(cipher, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reloaded, err := sessions.DecodeSessionState(encoded, cipher, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := provider.ValidateSessionWithError(context.Background(), reloaded); err != nil {
+		t.Fatalf("verified nonce-less refresh failed after Redis-style round trip: %v", err)
+	}
+	// Even an authenticated persisted marker cannot waive other JWT checks.
+	for _, mutation := range []string{"signature", "expiry", "issuer", "audience", "wrong-nonce"} {
+		t.Run(mutation, func(t *testing.T) {
+			changed := claims
+			switch mutation {
+			case "expiry":
+				changed.ExpiresAt = jwt.NewNumericDate(time.Now().Add(-time.Minute))
+			case "issuer":
+				changed.Issuer = "https://foreign.example"
+			case "audience":
+				changed.Audience = jwt.ClaimStrings{"foreign-client"}
+			case "wrong-nonce":
+				changed.Nonce = encryption.HashNonce([]byte("wrong"))
+			}
+			token, err := chthollySignedToken(key, changed)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if mutation == "signature" {
+				token += "tampered"
+			}
+			copy := *reloaded
+			copy.IDToken = token
+			if provider.ValidateSession(context.Background(), &copy) {
+				t.Fatal("persisted marker bypassed " + mutation)
+			}
+		})
+	}
+}
+
+func TestChthollyRefreshedIncorrectNonceDoesNotReplaceSession(t *testing.T) {
+	key := chthollySigningKey(t)
+	claims := defaultIDToken
+	claims.Nonce = encryption.HashNonce([]byte("different"))
+	raw, _ := chthollySignedToken(key, claims)
+	body, _ := json.Marshal(redeemTokenResponse{AccessToken: "new-access", RefreshToken: "new-refresh",
+		ExpiresIn: 3600, TokenType: "Bearer", IDToken: raw})
+	server, provider := newChthollyOIDCSetup(t, key, body)
+	defer server.Close()
+	session := &sessions.SessionState{IDToken: "original", AccessToken: "original-access",
+		Nonce: []byte(oidcNonce), RefreshToken: "original-refresh"}
+	if ok, err := provider.RefreshSession(context.Background(), session); ok || err == nil {
+		t.Fatal("wrong nonce accepted")
+	}
+	if session.IDToken != "original" || session.RefreshToken != "original-refresh" || session.OIDCNonceOptional {
+		t.Fatal("invalid refresh replaced authenticated state")
+	}
+}
+
+func TestChthollyProviderHTTPDeadline(t *testing.T) {
+	stopped := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = r.ParseForm()
+		<-r.Context().Done()
+		close(stopped)
+	}))
+	defer server.Close()
+	u, _ := url.Parse(server.URL)
+	provider := newOIDCProvider(u, false)
+	// The provider operation deadline also prevents oauth2 auth-style probing
+	// from replaying a timed-out exchange with a rotating refresh token.
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	start := time.Now()
+	_, err := provider.RefreshSession(ctx, &sessions.SessionState{RefreshToken: "original"})
+	elapsed := time.Since(start)
+	if err == nil || elapsed > 19*time.Second {
+		t.Fatalf("provider deadline not enforced: %v (%s)", err, elapsed)
+	}
+	select {
+	case <-stopped:
+	case <-time.After(time.Second):
+		t.Fatal("provider request survived deadline")
+	}
+}
