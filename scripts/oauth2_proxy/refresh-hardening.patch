+func TestChthollyAuthenticationDeadlineStopsStoreWork(t *testing.T) {
+	stopped := make(chan struct{})
+	store := &fakeSessionStore{LoadFunc: func(req *http.Request) (*sessionsapi.SessionState, error) {
+		<-req.Context().Done()
+		close(stopped)
+		return nil, sessionsapi.ErrSessionUnavailable
+	}, ClearFunc: func(http.ResponseWriter, *http.Request) error {
+		t.Error("authentication timeout cleared a server record")
+		return nil
+	}}
+	start := time.Now()
+	rw := chthollyServe(chthollyRefreshHandler(store, "http://127.0.0.1:1"),
+		httptest.NewRequest(http.MethodGet, "/oauth2/auth", nil))
+	if elapsed := time.Since(start); rw.Code != 503 || elapsed > 23*time.Second {
+		t.Fatalf("authentication deadline failed: status=%d duration=%s", rw.Code, elapsed)
+	}
+	select {
+	case <-stopped:
+	default:
+		t.Fatal("store work survived authentication response")
+	}
+}
