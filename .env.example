# The default entari.yml needs no credentials. Copy this file to .env only
# when enabling the matching sections in entari.local.yml. Never commit .env.

# WebUI / plugin workshop: choose a long, unique password.
WEBUI_PASSWORD=

# OneBot reverse WebSocket: configure the same token on both endpoints.
ONEBOT_TOKEN=

# Main LLM gateway and optional provider-specific models.
# Replace the example model catalog with models available to your account.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
DOUBAO_API_KEY=
DEEPSEEK_API_KEY=

# Optional web search. Empty disables Exa-backed search.
EXA_API_KEY=

# Official QQ adapter only; unrelated to OneBot credentials.
QQ_APP_ID=
QQ_APP_SECRET=

# Optional speech provider. Remove tts_service if you do not use it.
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_API_KEY=
FISH_API_KEY=
FISH_REFERENCE_ID=
