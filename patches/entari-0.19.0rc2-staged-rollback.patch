+_ReloadRecord = tuple[Plugin, list[str], dict[str, tuple[str, str | None]]]
+
+
+def _remember_reload(plugin: Plugin) -> list[_ReloadRecord]:
+    plugins = [plugin, *(plugin_service.plugins[sid] for sid in _collect_subtree(plugin))]
+    return [(item, item.subplugins.copy(), item.bindings.copy()) for item in plugins]
+
+
+def _restore_reload(records: list[_ReloadRecord]) -> None:
+    from arclet.alconna import command_manager
+    from ..command.provider import AlconnaSuppiler
+
+    commands = {}
+    for plugin, children, bindings in records:
+        plugin.subplugins[:] = children
+        plugin_service.bindings[plugin.id] = bindings
+        sys.modules[plugin.module.__name__] = plugin.proxy()
+        for slot in plugin._scope.subscribers:
+            try:
+                cmd = slot.subscriber.get_propagator(AlconnaSuppiler).cmd
+            except ValueError:
+                continue
+            commands[id(cmd)] = cmd
+    for plugin, _, _ in records:
+        parent_name, _, name = plugin.module.__name__.rpartition(".")
+        parent = sys.modules.get(parent_name)
+        if parent is not None:
+            setattr(parent, name, plugin.module)
+    for cmd in commands.values():
+        command_manager.register(cmd)
+        cmd.formatter.add(cmd)
+
